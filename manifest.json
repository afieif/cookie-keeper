{
  "manifest_version": 3,
  "name": "Cookie Keeper – Cookie Editor",
  "version": "0.1.0",
  "description": "View, edit, pin, protect, block, import and export cookies — for one site or every site.",
  "permissions": [
    "cookies",
    "storage",
    "unlimitedStorage",
    "webNavigation",
    "alarms",
    "sidePanel"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "incognito": "spanning",
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Cookie Keeper"
  },
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "devtools_page": "devtools.html"
}
